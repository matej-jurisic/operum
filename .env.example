# ==============================================================================
# Operum - root environment file
# ==============================================================================
# Consumed by docker-compose.yml:
#   - passed to the `backend` container as-is (env_file)
#   - a few values are also interpolated directly into docker-compose.yml
#     (Postgres credentials, Grafana admin password, monitoring profile)
#   - VITE_REACT_* values are passed as build args when the `frontend` image
#     is built, since Vite inlines them at build time, not at container start
#
# This only lists secrets and values that genuinely differ per deployment.
# Static, non-secret defaults (JWT issuer/audience, timeouts, MailGun route,
# AllowedHosts, ...) live in backend/src/Operum.API/appsettings.Production.json
# instead - add a line here only if you need to override one of those.
#
# Quick start:
#   cp .env.example .env
#   ./setup.ps1        # Windows, generates secrets in-place
#   ./setup.sh          # macOS/Linux, generates secrets in-place
#   docker-compose up -d
#
# Anywhere you see __GENERATE__ below, the setup script will replace it with a
# random value. You can also fill these in by hand if you'd rather not run it.
# ==============================================================================

# ----------------------------------------
# Required
# ----------------------------------------

# Origins allowed to call the API with credentials (ASP.NET Core CORS + used
# to build email confirmation links). Semicolon-separated, scheme required,
# no trailing slash.
ClientUrl=http://localhost:3000

# Base URL the backend uses to build links it sends out (e.g. email
# confirmation callback URLs). No trailing slash.
ServerUrl=http://localhost:5000

# Frontend build-time API URL. Vite inlines this into the JS bundle at
# `docker build` time - changing it requires rebuilding the frontend image,
# not just restarting the container.
VITE_REACT_API_URL=http://localhost:5000/api

# Password for the admin@example.com account seeded on first run.
AdminUserPassword=__GENERATE__

JwtSettings__Key=__GENERATE__

# These also configure the `postgres` container and `postgres_exporter`
# directly - change them here only, nothing else needs editing.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=operumdb

# ----------------------------------------
# Optional - Google Sign-In
# ----------------------------------------
# Leave blank to disable. Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add both
# http://localhost:3000 and your deployed ClientUrl as authorized origins.
# The frontend needs the Client ID; the backend verifies the token
# server-side and needs the same Client ID.

AUTHENTICATION__GOOGLE__CLIENTID=
AUTHENTICATION__GOOGLE__CLIENTSECRET=
VITE_REACT_GOOGLE_CLIENT=

# ----------------------------------------
# Optional - transactional email (MailGun)
# ----------------------------------------
# Leave blank to run without email: registration still works, email
# confirmation is just skipped.

MailGun__ApiKey=

# ----------------------------------------
# Optional - web push notifications (unfinished feature, opt-in)
# ----------------------------------------
# Leave Features__Notifications=false to skip generating VAPID keys.
# When enabled, generate a keypair with:
#   npx --yes web-push generate-vapid-keys --json
# (the setup scripts do this for you automatically).

Features__Notifications=false
VITE_REACT_NOTIFICATIONS_ENABLED=false
Vapid__PublicKey=__GENERATE__
Vapid__PrivateKey=__GENERATE__

# ----------------------------------------
# Optional - monitoring stack (Prometheus/Grafana/exporters)
# ----------------------------------------
# These services are behind the "monitoring" Compose profile and are not
# started by a plain `docker-compose up`. Uncomment the line below to
# include them (needed on the production host; usually not needed locally).

# COMPOSE_PROFILES=monitoring

GRAFANA_ADMIN_PASSWORD=__GENERATE__
